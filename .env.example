# Real managed Azure DocumentDB only. Never put a token or database password here.
DOCUMENTDB_HOST=replace-me.mongocluster.cosmos.azure.com
DOCUMENTDB_DATABASE=app_starter_your_disposable_suffix
ALLOW_SAMPLE_WRITES=app_starter_your_disposable_suffix
AZURE_AUTH_MODE=cli
APP_ORIGIN=http://127.0.0.1:3000
PORT=3000
# Only for opt-in live integration, which creates and deletes its own individual rows:
# RUN_LIVE_TESTS=I_OWN_THIS_DISPOSABLE_DATABASE
