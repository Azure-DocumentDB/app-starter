{
  "name": "azure-documentdb-app-starter", "version": "1.0.0", "private": true,
  "description": "Passwordless task workspace for managed Azure DocumentDB",
  "type": "module", "engines": { "node": ">=24.20.0 <25" },
  "scripts": {
    "build": "tsc", "start": "node --env-file-if-exists=.env dist/server.js",
    "dev": "npm run build && npm start", "seed": "node --env-file-if-exists=.env dist/seed.js",
    "test": "npm run build && node --test test/*.test.mjs",
    "test:live": "npm run build && node --env-file-if-exists=.env --test test/live.integration.mjs",
    "bundle": "npm run build && node scripts/bundle.mjs", "preflight": "node scripts/preflight.mjs"
  },
  "dependencies": { "@azure/identity": "4.13.3", "mongodb": "7.7.0" },
  "devDependencies": { "@types/node": "24.19.2", "jsdom": "30.1.2", "typescript": "5.9.3" }
}
